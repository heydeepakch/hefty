{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storage Cleanup Helper",
  "version": "0.1.0",
  "identifier": "com.heydeepakch.storage-cleanup-helper",
  "build": {
    "frontendDist": "ui",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "python scripts/dev-server.py"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Storage Cleanup Helper",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 540,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "heydeepakch"
  }
}
